{
  "title": "HHKB-style Arrow Keys",
  "rules": [
    {
      "description": "HHKB Arrows: Right Shift + [ ; ' / → arrows, + Ctrl → move by word",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "quote",
            "modifiers": { "mandatory": ["right_shift", "control"], "optional": ["any"] }
          },
          "to": [{ "key_code": "right_arrow", "modifiers": ["option"] }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "semicolon",
            "modifiers": { "mandatory": ["right_shift", "control"], "optional": ["any"] }
          },
          "to": [{ "key_code": "left_arrow", "modifiers": ["option"] }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "open_bracket",
            "modifiers": { "mandatory": ["right_shift"], "optional": ["any"] }
          },
          "to": [{ "key_code": "up_arrow" }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "semicolon",
            "modifiers": {
              "mandatory": ["right_shift"],
              "optional": ["left_shift", "left_command", "left_option", "right_command", "right_option"]
            }
          },
          "to": [{ "key_code": "left_arrow" }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "quote",
            "modifiers": {
              "mandatory": ["right_shift"],
              "optional": ["left_shift", "left_command", "left_option", "right_command", "right_option"]
            }
          },
          "to": [{ "key_code": "right_arrow" }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "slash",
            "modifiers": { "mandatory": ["right_shift"], "optional": ["any"] }
          },
          "to": [{ "key_code": "down_arrow" }]
        }
      ]
    }
  ]
}
